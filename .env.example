# Required: shared by schema migration and runtime services.
# Production uses the shared Alibaba Cloud RDS database with TLS enabled.
POSTGRES_DSN=postgresql://game:change-me@your-instance.pg.rds.aliyuncs.com:5432/gamebus_prod?sslmode=require

# Required browser origin for WebSocket connections.
WS_ALLOWED_ORIGINS=https://board.gamebus.online

# Shared infrastructure from ../infra on global-network.
REDIS_ADDR=global-redis:6379
GAME_REDIS_DB=0
NATS_URL=nats://global-nats:4222
ETCD_ENDPOINTS=global-etcd:2379
ETCD_USERNAME=
ETCD_PASSWORD=

# Cross-service defaults.
AUTH_RPC_ADDR=auth-backend:19090
AUTH_RPC_PSM=pam.auth.rpc
AUTH_RPC_TIMEOUT=2s
PROFILE_REFRESH_INTERVAL=60s
CONTROL_RPC_TIMEOUT=30s
PAM_SERVICE_REGISTRY_PREFIX=pam/services

# Image selection for manual deployments. GitHub Actions overrides the tag.
GAME_PLATFORM_IMAGE_REGISTRY=sgccr.ccs.tencentyun.com/tengxuntcr
GAME_PLATFORM_IMAGE_TAG=latest
SERVICE_VERSION=latest

# Game RoomHost slots use complete immutable image references. Start only the
# active slot and the candidate slot selected by deploy-game-slot.sh.
ACQUIRE_ROOMHOST_A_IMAGE=sgccr.ccs.tencentyun.com/tengxuntcr/game-platform-roomhost-acquire:git-sha
ACQUIRE_ROOMHOST_B_IMAGE=sgccr.ccs.tencentyun.com/tengxuntcr/game-platform-roomhost-acquire:git-sha
ACQUIRE_ROOMHOST_A_VERSION=git-sha
ACQUIRE_ROOMHOST_B_VERSION=git-sha
DAVINCI_ROOMHOST_A_IMAGE=sgccr.ccs.tencentyun.com/tengxuntcr/game-platform-roomhost-davinci:git-sha
DAVINCI_ROOMHOST_B_IMAGE=sgccr.ccs.tencentyun.com/tengxuntcr/game-platform-roomhost-davinci:git-sha
DAVINCI_ROOMHOST_A_VERSION=git-sha
DAVINCI_ROOMHOST_B_VERSION=git-sha
SPLENDOR_ROOMHOST_A_IMAGE=sgccr.ccs.tencentyun.com/tengxuntcr/game-platform-roomhost-splendor:git-sha
SPLENDOR_ROOMHOST_B_IMAGE=sgccr.ccs.tencentyun.com/tengxuntcr/game-platform-roomhost-splendor:git-sha
SPLENDOR_ROOMHOST_A_VERSION=git-sha
SPLENDOR_ROOMHOST_B_VERSION=git-sha
YINSH_ROOMHOST_A_IMAGE=sgccr.ccs.tencentyun.com/tengxuntcr/game-platform-roomhost-yinsh:git-sha
YINSH_ROOMHOST_B_IMAGE=sgccr.ccs.tencentyun.com/tengxuntcr/game-platform-roomhost-yinsh:git-sha
YINSH_ROOMHOST_A_VERSION=git-sha
YINSH_ROOMHOST_B_VERSION=git-sha
OTHELLO_ROOMHOST_A_IMAGE=sgccr.ccs.tencentyun.com/tengxuntcr/game-platform-roomhost-othello:git-sha
OTHELLO_ROOMHOST_B_IMAGE=sgccr.ccs.tencentyun.com/tengxuntcr/game-platform-roomhost-othello:git-sha
OTHELLO_ROOMHOST_A_VERSION=git-sha
OTHELLO_ROOMHOST_B_VERSION=git-sha
FUGITIVE_ROOMHOST_A_IMAGE=sgccr.ccs.tencentyun.com/tengxuntcr/game-platform-roomhost-fugitive:git-sha
FUGITIVE_ROOMHOST_B_IMAGE=sgccr.ccs.tencentyun.com/tengxuntcr/game-platform-roomhost-fugitive:git-sha
FUGITIVE_ROOMHOST_A_VERSION=git-sha
FUGITIVE_ROOMHOST_B_VERSION=git-sha
WARCHEST_ROOMHOST_A_IMAGE=sgccr.ccs.tencentyun.com/tengxuntcr/game-platform-roomhost-warchest:git-sha
WARCHEST_ROOMHOST_B_IMAGE=sgccr.ccs.tencentyun.com/tengxuntcr/game-platform-roomhost-warchest:git-sha
WARCHEST_ROOMHOST_A_VERSION=git-sha
WARCHEST_ROOMHOST_B_VERSION=git-sha
QUORIDOR_ROOMHOST_A_IMAGE=sgccr.ccs.tencentyun.com/tengxuntcr/game-platform-roomhost-quoridor:git-sha
QUORIDOR_ROOMHOST_B_IMAGE=sgccr.ccs.tencentyun.com/tengxuntcr/game-platform-roomhost-quoridor:git-sha
QUORIDOR_ROOMHOST_A_VERSION=git-sha
QUORIDOR_ROOMHOST_B_VERSION=git-sha
ONITAMA_ROOMHOST_A_IMAGE=sgccr.ccs.tencentyun.com/tengxuntcr/game-platform-roomhost-onitama:git-sha
ONITAMA_ROOMHOST_B_IMAGE=sgccr.ccs.tencentyun.com/tengxuntcr/game-platform-roomhost-onitama:git-sha
ONITAMA_ROOMHOST_A_VERSION=git-sha
ONITAMA_ROOMHOST_B_VERSION=git-sha

# Shared telemetry.
OTEL_EXPORTER_OTLP_ENDPOINT=http://global-otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
