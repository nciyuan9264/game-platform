# Required: shared by schema migration and runtime services.
POSTGRES_DSN=postgres://game:change-me@rds.example.com:5432/game_platform?sslmode=require

# Required browser origin for WebSocket connections.
WS_ALLOWED_ORIGINS=https://board.gamebus.online

# Shared infrastructure from ../infra on global-network.
REDIS_ADDR=global-redis:6379
GAME_REDIS_DB=0
NATS_URL=nats://global-nats:4222
ETCD_ENDPOINTS=global-etcd:2379
ETCD_USERNAME=
ETCD_PASSWORD=

# Cross-service defaults.
AUTH_RPC_ADDR=auth-backend:19090
AUTH_RPC_PSM=pam.auth.rpc
PAM_SERVICE_REGISTRY_PREFIX=pam/services

# Image selection for manual deployments. GitHub Actions overrides the tag.
GAME_PLATFORM_IMAGE_REGISTRY=sgccr.ccs.tencentyun.com/tengxuntcr
GAME_PLATFORM_IMAGE_TAG=latest
SERVICE_VERSION=latest

# Shared telemetry.
OTEL_EXPORTER_OTLP_ENDPOINT=http://global-otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
